rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection - Read access for everyone, write access for admins only
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow delete: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // Contacts collection - Write access for everyone, read access for admins only
    match /contacts/{contactId} {
      allow create: if true;
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow update, delete: if false; // Contacts cannot be modified
    }
    
    // Admins collection - Only authenticated users can read their own admin status
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Admin status can only be set manually in Firebase console
    }
  }
}